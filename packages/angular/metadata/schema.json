{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "absoluteui-angular-metadata.schema.json",
  "title": "AbsoluteUI Angular entry point metadata",
  "description": "Generated by scripts/generate-angular-metadata.mjs from the built declarations of @absoluteui/angular (docs/PLAN-R9-ANGULAR.md D24). One file per entry point.",
  "type": "object",
  "required": ["schemaVersion", "entry", "declarations"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "entry": { "type": "string", "pattern": "^@absoluteui/angular(/[a-z0-9-]+)?$" },
    "declarations": { "type": "array", "items": { "$ref": "#/$defs/declaration" } },
    "functions": { "type": "array", "items": { "$ref": "#/$defs/member" } },
    "constants": { "type": "array", "items": { "type": "object", "required": ["name", "type"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": false } },
    "types": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": false } },
    "reexports": { "type": "array", "items": { "type": "string" } },
    "example": { "type": "array", "items": { "type": "object", "required": ["language", "code"], "properties": { "language": { "enum": ["ts", "html"] }, "code": { "type": "string" } }, "additionalProperties": false } }
  },
  "$defs": {
    "member": {
      "type": "object",
      "required": ["name", "signature"],
      "properties": { "name": { "type": "string" }, "static": { "type": "boolean" }, "signature": { "type": "string" }, "description": { "type": "string" } },
      "additionalProperties": false
    },
    "declaration": {
      "type": "object",
      "required": ["kind", "name", "methods"],
      "properties": {
        "kind": { "enum": ["component", "directive", "service", "harness", "class"] },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "selector": { "type": "string" },
        "exportAs": { "type": "array", "items": { "type": "string" } },
        "source": { "enum": ["generated", "hand-written"] },
        "component": { "type": "string", "description": "Neutral component name (packages/components/metadata/<component>)." },
        "configKey": { "type": "string" },
        "forms": { "type": "object", "required": ["controlValueAccessor", "validator", "valueType"], "properties": { "controlValueAccessor": { "type": "boolean" }, "validator": { "type": "boolean" }, "valueType": { "type": "string" } }, "additionalProperties": false },
        "inputs": { "type": "array", "items": { "type": "object", "required": ["name", "type", "required"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "required": { "type": "boolean" }, "default": { "type": "string" }, "configurable": { "type": "boolean" }, "description": { "type": "string" } }, "additionalProperties": false } },
        "models": { "type": "array", "items": { "type": "object", "required": ["name", "type", "change"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "change": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": false } },
        "outputs": { "type": "array", "items": { "type": "object", "required": ["name", "payload"], "properties": { "name": { "type": "string" }, "payload": { "type": "string" }, "event": { "type": "string" }, "detail": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": false } },
        "properties": { "type": "array", "items": { "type": "object", "required": ["name", "type"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "description": { "type": "string" } }, "additionalProperties": false } },
        "methods": { "type": "array", "items": { "$ref": "#/$defs/member" } },
        "templates": { "type": "array", "items": { "type": "string" } },
        "projection": { "type": "object" },
        "serverRendering": { "enum": ["server", "browser"] },
        "serverRenderingNote": { "type": "string" },
        "accessibility": { "type": "object", "required": ["source"], "properties": { "pattern": { "type": "string" }, "source": { "type": "string" } }, "additionalProperties": false },
        "limitations": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
