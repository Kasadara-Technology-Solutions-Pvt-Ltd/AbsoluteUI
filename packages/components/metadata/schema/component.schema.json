{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "absoluteui/component.schema.json",
  "title": "AbsoluteUI component descriptor (SPEC section 21.2)",
  "type": "object",
  "required": ["schemaVersion", "name", "displayName", "category", "package", "import", "styleImport", "purpose", "whenToUse", "whenNotToUse", "internalDependencies", "states", "responsive", "rtl", "theme", "timezone", "security", "dataHandling", "performance", "limitations", "unsupported", "antiPatterns", "adapters", "versionIntroduced", "deprecated"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "name": { "type": "string" },
    "displayName": { "type": "string" },
    "category": { "type": "string" },
    "package": { "type": "string" },
    "import": { "type": "string" },
    "styleImport": { "type": "string" },
    "purpose": { "type": "string" },
    "whenToUse": { "type": "array", "items": { "type": "string" } },
    "whenNotToUse": { "type": "array", "items": { "type": "string" } },
    "internalDependencies": { "type": "array", "items": { "type": "string" } },
    "states": { "type": "array", "items": { "type": "string" } },
    "responsive": { "type": "string" },
    "rtl": { "type": "string" },
    "theme": { "type": "string" },
    "timezone": { "type": "string" },
    "security": { "type": "string" },
    "dataHandling": { "type": "string" },
    "performance": {
      "type": "object",
      "required": ["budgets", "testedScale"],
      "properties": {
        "budgets": {
          "type": "array",
          "items": { "type": "object", "required": ["metric", "budget"], "properties": { "metric": { "type": "string" }, "budget": { "type": "string" } } }
        },
        "testedScale": { "type": "string" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "unsupported": { "type": "array", "items": { "type": "string" } },
    "antiPatterns": { "type": "array", "items": { "type": "string" } },
    "adapters": {
      "type": "object",
      "required": ["angular", "react", "vue"],
      "properties": { "angular": { "type": "string" }, "react": { "type": "string" }, "vue": { "type": "string" } }
    },
    "versionIntroduced": { "type": "string" },
    "deprecated": { "type": ["string", "null"] }
  }
}
