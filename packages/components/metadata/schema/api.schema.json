{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "absoluteui/api.schema.json",
  "title": "AbsoluteUI component API (SPEC section 21.2)",
  "type": "object",
  "required": ["schemaVersion", "component", "factory", "configKey", "options", "properties", "methods", "events", "contentAreas", "cssClasses", "iconSlots"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "component": { "type": "string" },
    "factory": { "type": "object", "required": ["name", "signature"], "properties": { "name": { "type": "string" }, "signature": { "type": "string" } } },
    "configKey": { "type": "string" },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "required", "globallyConfigurable", "description"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "default": {},
          "required": { "type": "boolean" },
          "globallyConfigurable": { "type": "boolean" },
          "inheritedFromCommon": { "type": "boolean" },
          "mutability": { "type": "string", "enum": ["dynamic", "init-only"] },
          "description": { "type": "string" }
        }
      }
    },
    "properties": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "type", "description"], "properties": { "name": { "type": "string" }, "type": { "type": "string" }, "description": { "type": "string" } } }
    },
    "methods": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "signature", "description"], "properties": { "name": { "type": "string" }, "signature": { "type": "string" }, "description": { "type": "string" } } }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "detail", "bubbles", "cancelable", "description"],
        "properties": {
          "name": { "type": "string" },
          "detail": { "type": "string" },
          "bubbles": { "type": "boolean" },
          "cancelable": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "contentAreas": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "description"], "properties": { "name": { "type": "string" }, "description": { "type": "string" } } }
    },
    "cssClasses": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "description"], "properties": { "name": { "type": "string" }, "description": { "type": "string" } } }
    },
    "iconSlots": {
      "type": "array",
      "items": { "type": "object", "required": ["name", "default"], "properties": { "name": { "type": "string" }, "default": { "type": "string" } } }
    }
  }
}
