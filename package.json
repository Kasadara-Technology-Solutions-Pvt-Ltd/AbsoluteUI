{
  "name": "absoluteui-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/utilities",
    "packages/helpers",
    "packages/services",
    "packages/theme",
    "packages/icons",
    "packages/components",
    "packages/angular",
    "packages/mcp",
    "apps/site",
    "apps/marketing"
  ],
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:types": "tsc -b tsconfig.build.json",
    "build:js": "node scripts/build.mjs",
    "build": "npm run clean && npm run build:types && npm run build:js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp:build": "node packages/mcp/scripts/build.mjs && node packages/mcp/scripts/build-content.mjs",
    "mcp:content": "node packages/mcp/scripts/build-content.mjs",
    "check:mcp": "node packages/mcp/scripts/check.mjs",
    "test:mcp": "vitest run -c vitest.mcp.config.ts",
    "lint": "eslint .",
    "test": "node scripts/generate-api-examples.mjs && vitest run",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:browsers": "node scripts/check-browser-support.mjs",
    "check:readmes": "node scripts/generate-readmes.mjs --check",
    "check:legal": "node scripts/check-legal.mjs",
    "generate:readmes": "node scripts/generate-readmes.mjs",
    "check:banner": "node scripts/check-banner.mjs",
    "check:metadata": "node scripts/generate-token-usage.mjs --check && node scripts/check-metadata.mjs",
    "generate:token-usage": "node scripts/generate-token-usage.mjs",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run check:icons && npm run test && npm run test:mcp && npm run check:mcp && npm run test:angular && npm run check:angular && npm run check:boundaries && npm run check:banner && npm run check:readmes && npm run check:browsers && npm run check:legal && npm run check:pack && npm run check:contrast && npm run check:metadata && npm run check:treeshake && npm run check:originality && npm run check:ssr && npm run check:designer && npm run test:e2e && npm run site:build && npm run marketing:build && npm run marketing:check",
    "check:treeshake": "node scripts/check-treeshake.mjs",
    "icons:compile": "node scripts/icons/compile.mjs && node scripts/icons/build-catalog.mjs",
    "check:originality": "node scripts/icons/originality.mjs",
    "check:icons": "node --test scripts/icons/tools.test.mjs && node scripts/icons/compile.mjs --check && node scripts/icons/build-catalog.mjs --check",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:visual:update": "playwright test visual --update-snapshots",
    "designer": "node apps/theme-designer/serve.mjs",
    "designer:build": "tsc -p apps/theme-designer/tsconfig.json && node apps/theme-designer/dist.mjs",
    "check:designer": "tsc -p apps/theme-designer/tsconfig.json && node apps/theme-designer/dist.mjs",
    "test:angular": "node node_modules/@angular/compiler-cli/bundles/src/bin/ngc.js -p packages/angular/tsconfig.test.json && node scripts/angular-ssr.mjs && vitest run -c vitest.angular.config.ts",
    "check:angular": "node scripts/generate-angular.mjs --check && node scripts/check-angular.mjs && node scripts/angular-ssr-sweep.mjs --check && node scripts/generate-angular-metadata.mjs --check && node scripts/check-angular-examples.mjs && node scripts/angular-api-snapshot.mjs",
    "generate:angular": "node scripts/generate-angular.mjs",
    "generate:angular-metadata": "node scripts/generate-angular-metadata.mjs",
    "api:angular": "node scripts/angular-api-snapshot.mjs --update",
    "site": "npm run dev -w apps/site",
    "site:build": "npm run build -w apps/site",
    "site:evidence": "npm run evidence -w apps/site",
    "marketing": "npm run dev -w apps/marketing",
    "marketing:build": "npm run build -w apps/marketing --",
    "marketing:check": "npm run check:pages -w apps/marketing",
    "marketing:capture": "npm run capture -w apps/marketing",
    "web:build": "npm run marketing:build && npm run site:build && npm run designer:build && node scripts/web/build.mjs",
    "web:assemble": "node scripts/web/build.mjs",
    "web:check": "node scripts/web/check.mjs",
    "web:serve": "node scripts/web/serve.mjs",
    "web:redirects": "node scripts/web/redirects.mjs",
    "check:ssr": "node scripts/check-ssr.mjs"
  },
  "devDependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@fontsource-variable/cairo": "5.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@material-symbols/svg-400": "^0.47.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.2",
    "axe-core": "^4.13.0",
    "dompurify": "^3.4.16",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-regexp": "^3.3.1",
    "fast-check": "^4.10.2",
    "lucide": "^1.49.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2",
    "sass": "^1.105.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "web-features": "3.42.0"
  }
}
