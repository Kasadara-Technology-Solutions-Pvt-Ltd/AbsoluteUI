---
import { ANGULAR_DOCS, GET_STARTED, designer, docs } from '../site';
import legal from '../generated/legal.json';
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="stack">
        <a class="brand" href="/">
          <img class="brand-light" src="/logo-light.svg" alt="" width="34" height="34" />
          <img class="brand-dark" src="/logo-dark.svg" alt="" width="34" height="34" />
          <span>AbsoluteUI</span>
        </a>
        <p>Enterprise UI components with zero runtime dependencies. Free to use, forever.</p>
      </div>
      <div>
        <h2>Product</h2>
        <ul>
          <li><a href="/components/">Components</a></li>
          <li><a href="/blocks/">Blocks</a></li>
          <li><a href="/theme-designer/">Theme Designer</a></li>
          <li><a href="/enterprise/">Enterprise</a></li>
          <li><a href="/demos/">Demos</a></li>
        </ul>
      </div>
      <div>
        <h2>Developers</h2>
        <ul>
          <li><a href={GET_STARTED}>Get started</a></li>
          <li><a href={docs()}>Documentation</a></li>
          <li><a href={ANGULAR_DOCS}>Angular</a></li>
          <li><a href={docs('/docs/api/core/')}>API reference</a></li>
          <li><a href={designer()}>Open the Theme Designer</a></li>
        </ul>
      </div>
      <div>
        <h2>Trust</h2>
        <ul>
          <li><a href="/security/">Security</a></li>
          <li><a href="/advisory/">Advisories</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
          <li><a href="/performance/">Performance</a></li>
        </ul>
      </div>
      <div>
        <h2>Legal</h2>
        <ul>
          <li><a href="/license/">License</a></li>
          <li><a href={legal.repository} rel="noopener">Source on GitHub</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
          <li><a href="/notices/">Third-party notices</a></li>
          <li><button class="link-button" type="button" data-consent-reset>Cookie settings</button></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <p>(c) {legal.copyrightYear} {legal.company}. AbsoluteUI is open source under the Apache License 2.0 (<a href="/license/">license</a>), Kasadara's contribution to the open-source community.</p>
      <p>AbsoluteUI and its logo are trademarks of {legal.company}.</p>
    </div>
  </div>
</footer>
